{% extends 'base.html.twig' %}

{% block body %}

<div class="div-titre">
        <a href="{{ path('app_charges') }}" class="btn-retour">Retour</a>
        <h1>Modifier une charge</h1>
</div>

<form method="post">

    <div>
        <label>Montant</label>
        <input type="number" name="montant" value="{{ charge.montant }}">
    </div>

    <div>
        <label>Date</label>
        <input type="date" name="date" value="{{ charge.dateMES ? charge.dateMES|date('Y-m-d') : '' }}">
    </div>

    <button type="submit">Enregistrer</button>

</form>

<link rel="stylesheet" href="{{ asset('css/style_form.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">


{% endblock %}