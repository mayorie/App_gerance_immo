{% extends 'base.html.twig' %}

{% block title %}index charges{% endblock %}

{% block body %}


<div class="div-titre">
        <a href="{{ path('app_home') }}" class="btn-retour">retour</a>
        <h1>Liste des charges</h1>
        <a href="{{ path('charges_batch') }}" class="btn-create">➕ Créer révisions des charges</a>
</div>

<form method="get" action="{{ path('app_charges') }}">
    <label for="locataire">Filtrer par locataire :</label>

    <select name="locataireId" id="locataire">
        <option value="">-- Tous les locataires --</option>

        {% for l in locataires %}
            <option value="{{ l.id }}"
                {% if locataire and locataire.id == l.id %}selected{% endif %}>
                {{ l.nom }} 
                {{ l.prenom }}
            </option>
        {% endfor %}
    </select>

    <button type="submit">Filtrer</button>
</form>

<hr>

{% if locataire %}
    <h2>Charges de {{ locataire.nom }} {{ locataire.prenom }}</h2>
{% else %}
    <h2>Charges & Révisions des charges</h2>
{% endif %}

{% if charges is empty %}
    <p>Aucune charge trouvée. (c'est pas normal)</p>
{% else %}

<table style="border-collapse: separate; border-spacing: 10px; width: 100%;">
    <thead>
        <tr>
            <th>Locataire</th>
            <th>Logement</th>
            <th>Montant</th>
            <th>Date</th>
            <th>MODIF</th>
            <th>SUPPR</th>
        </tr>
    </thead>
    <tbody>
        {% for charge in charges %}
            <tr>
                <td>{{ charge.LocatairesID.nom }} {{ charge.LocatairesID.prenom }}</td>
                <td>{{ charge.LocatairesID.LogementsID.idAppart }}</td>
                <td>{{ charge.montant }} €</td>
                <td>{{ charge.dateMES ? charge.dateMES|date('d/m/Y') : '-' }}</td>
                <td>
                    <a href="{{ path('charges_edit', {'id': charge.id}) }}" >
                    ✏️
                    </a>
                </td>
                <td>
                    <form method="post" action="{{ path('charges_delete', {'id': charge.id}) }}" onsubmit="return confirm('Supprimer cette charge ?');" >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ charge.id) }}">
                        <button type="submit">🗑️</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endif %}

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
{% endblock %}