<div class="div-titre" style="justify-content: flex-start;">
    <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
    <h1 style="margin-left: 200px;">Quittances PDF</h1>
</div>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-{{ type }}" style="padding: 10px; margin: 10px 0; border-radius: 5px; text-align: center;">
            {% if type == 'success' %}
                <div style="background: #d4edda; color: #155724; border: 1px solid #c3e6cb;">{{ message }}</div>
            {% elseif type == 'error' %}
                <div style="background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">{{ message }}</div>
            {% elseif type == 'warning' %}
                <div style="background: #fff3cd; color: #856404; border: 1px solid #ffeaa7;">{{ message }}</div>
            {% else %}
                <div style="background: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb;">{{ message }}</div>
            {% endif %}
        </div>
    {% endfor %}
{% endfor %}

<form method="get">

    <label>Mois :</label>

    <select name="mois" onchange="this.form.submit()">

        {% for m in 1..12 %}
            <option
                value="{{ m }}"
                {% if m == mois %}selected{% endif %}
            >
                {{ m }}
            </option>
        {% endfor %}

    </select>

    <label>Année :</label>

    <select name="annee" onchange="this.form.submit()">

        {% for a in (annee-5)..(annee+1) %}
            <option
                value="{{ a }}"
                {% if a == annee %}selected{% endif %}
            >
                {{ a }}
            </option>
        {% endfor %}

    </select>

    <a href="#" id="downloadZip" style="margin-left: 20px;" class="btn-export">📦 Télécharger tout en ZIP / Envoi des emails
    </a>&nbsp;(Si un fichier existe déjà, il sera supprimé.)

</form>

<br>

<table style="border-collapse: separate; border-spacing: 8px 5px;">
    <thead>
        <tr>
            <th>Locataire</th>
            <th>Appartement</th>
            <th>Aperçu</th>
            <th>PDF</th>
            <th style="text-align: center;">
                <input type="checkbox" id="selectAllEmails" title="Tout sélectionner / désélectionner">
                <label for="selectAllEmails" style="cursor: pointer;">Emails</label>
            </th>
        </tr>
    </thead>

    <tbody>

    {% for locataire in locataires %}
        <tr>
            <td>
                {{ locataire.nom }}
                {{ locataire.prenom }}
            </td>

            <td>
                {{ locataire.LogementsID.idAppart }}
            </td>

            <td>
                <a
                    href="{{ path('export_pdf_preview', {
                        id: locataire.id,
                        mois: mois,
                        annee: annee
                    }) }}"
                    target="_blank"
                >
                    👁️
                </a>
            </td>
            
            <td>
                <a
                    href="{{ path('export_pdf', {
                        id: locataire.id,
                        mois: mois,
                        annee: annee
                    }) }}"
                    target="_blank"
                >
                    📄
                </a>
            </td>

            <td style="text-align: center;">
                <input type="checkbox" class="email-checkbox" value="{{ locataire.id }}">
            </td>
        </tr>
    {% endfor %}

    </tbody>
</table>

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

<script>
document.addEventListener('DOMContentLoaded', function() {
    const selectAllEmails = document.getElementById('selectAllEmails');
    const emailCheckboxes = document.querySelectorAll('.email-checkbox');
    const downloadZipButton = document.getElementById('downloadZip');
    const mois = {{ mois }};
    const annee = {{ annee }};

    function updateDownloadUrl() {
        let url = '/exports/pdf/batch/zip?mois=' + mois + '&annee=' + annee;
        
        const selectedIds = Array.from(emailCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

        if (selectedIds.length > 0) {
            url += '&locataire_emails=' + selectedIds.join(',');
        }
        
        downloadZipButton.href = url;
    }

    if (selectAllEmails) {
        selectAllEmails.addEventListener('change', function() {
            emailCheckboxes.forEach(cb => {
                cb.checked = selectAllEmails.checked;
            });
            updateDownloadUrl();
        });
    }

    emailCheckboxes.forEach(cb => {
        cb.addEventListener('change', function() {
            if (!cb.checked && selectAllEmails) {
                selectAllEmails.checked = false;
            } else if (selectAllEmails) {
                const allChecked = Array.from(emailCheckboxes).every(c => c.checked);
                selectAllEmails.checked = allChecked;
            }
            updateDownloadUrl();
        });
    });

    updateDownloadUrl();
});
</script>