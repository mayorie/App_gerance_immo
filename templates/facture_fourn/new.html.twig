{% extends 'base.html.twig' %}

{% block title %}Nouvelle Facture Fournisseur{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('facture_fourn_index') }}" class="btn-retour">Retour</a>
    <h1>Nouvelle facture fournisseur</h1>
</div>

<form method="post">

    <div>
        <label>Date facture</label>
        <input type="date" name="date_facture" required>
    </div>

    <div>
        <label>Fournisseur</label>
        <input type="text" name="fournisseur" required>
    </div>

    <div>
        <label>Compte PCG 1</label>
        <select name="pcg_id" required>
            <option value="">-- Sélectionner --</option>
            {% for pcg in pcgs %}
                <option value="{{ pcg.id }}">{{ pcg.compte }} - {{ pcg.libelle }}</option>
            {% endfor %}
        </select>
    </div>

    <div>
        <label>Montant 1 (€)</label>
        <input type="number" step="0.01" name="montant" required>
    </div>

    <div>
        <label>Compte PCG 2</label>
        <select name="pcg2_id">
            <option value="">-- Sélectionner --</option>
            {% for pcg in pcgs %}
                <option value="{{ pcg.id }}">{{ pcg.compte }} - {{ pcg.libelle }}</option>
            {% endfor %}
        </select>
    </div>

    <div>
        <label>Montant 2 (€)</label>
        <input type="number" step="0.01" name="montant2">
    </div>

    <div>
        <label>Remise (€)</label>
        <input type="number" step="0.01" name="remise">
    </div>

    <div>
        <label>Motif</label>
        <input type="text" name="motif">
    </div>

    <div>
        <label>Date paiement</label>
        <input type="date" name="date_paiement" required>
    </div>

    <div>
        <label>Montant paiement (€)</label>
        <input type="number" step="0.01" name="montant_paiement" id="montant_paiement">
    </div>
    
    <div>
        <label>Mode de paiement</label>
        <select name="mode" required>
            <option value="">-- Sélectionner --</option>
            <option value="VIR">VIR</option>
            <option value="CB">CB</option>
            <option value="PRELEV">PRELEV</option>
            <option value="AUTRES">AUTRES</option>
        </select>
    </div>

    <button type="submit">Enregistrer</button>

</form>

<link rel="stylesheet" href="{{ asset('css/style_form.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const montant1Input = document.querySelector('input[name="montant"]');
        const montantPaiementInput = document.getElementById('montant_paiement');

        // Initialiser montant_paiement avec la valeur de montant 1
        if (montant1Input && montantPaiementInput) {
            montantPaiementInput.value = montant1Input.value;

            // Mettre à jour automatiquement quand montant 1 change
            montant1Input.addEventListener('input', function() {
                montantPaiementInput.value = this.value;
            });
        }
    });
</script>

{% endblock %}
