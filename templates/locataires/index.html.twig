{% extends 'base.html.twig' %}

{% block title %}index locataires{% endblock %}

{% block body %}



    <div class="div-titre">
        <h1>Index des locataires :</h1>
        <a href="{{ path('locataires_new') }}" class="btn-create">
            ➕ Créer un locataire
        </a>
    </div>

    <table style="border-collapse: separate; border-spacing: 10px; width: 100%;">
    <thead>
        <tr>
            <th>PRESENT</th>
            <th>NOM</th>
            <th>PRENOM</th>
            <th>TEL</th>
            <th>MAIL</th>
            <th>LOGEMENT</th>
            <th>DEBUT BAIL</th>
            <th>CAUTION</th>
            <th>LOYER HC</th>
            <th>CHARGES</th>
            <th>PACK S.</th>
            <th>RESTANT DU</th>
            <th>FIN BAIL</th>
            <th>NUM COMPTA</th>
            <th>MODIF</th>
            <th>SUPPR</th>
        </tr>
    </thead>

    <tbody>
        {% for locataire in locataires %}
            <tr>
                <td>
                    <span class="status {{ locataire.aQuitteLeLogement ? 'status-red' : 'status-green' }}"></span>
                </td>
                <td>{{ locataire.nom }}</td>
                <td>{{ locataire.prenom }}</td>
                <td>{{ locataire.tel }}</td>
                <td>{{ locataire.mail }}</td>
                <td>{{ locataire.LogementsID.idAppart }}</td>
                
                <td>{{ locataire.debutBail|date('d/m/Y') }}</td>
                <td>{{ locataire.montantCaution }}</td>
                <td>{{ locataire.getLatestLoyer.montant }}</td>
                <td>{{ locataire.getLatestCharge.montant }}</td>
                <td>{{ locataire.getLatestPackServices.montant }}</td>
                <td>{{ locataire.restantDuTropPercu }}</td>
                <td>{{ locataire.dateDeSortie|date('d/m/Y') }}</td>
                <td>{{ locataire.numComptable }}</td>
                <td>
                    <a href="{{ path('locataires_edit', {id: locataire.id}) }}" >
                    ✏️
                    </a>
                </td>
                <td>
                    <form method="post" action="{{ path('locataire_delete', {'id': locataire.id}) }}" onsubmit="return confirm('Supprimer ce locataire ?');" >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ locataire.id) }}">
                        <button type="submit">🗑️</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
{% endblock %}
