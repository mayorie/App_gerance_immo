{% extends 'base.html.twig' %}

{% block title %}ajout locataires{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_locataires') }}" class="btn-retour">Retour</a>
    <h1>Ajouter un locataire</h1>
</div>

{{ form_start(form) }}

{{ form_errors(form) }}

    {{ form_row(form.nom) }}
    {{ form_row(form.prenom) }}
    {{ form_row(form.tel) }}
    {{ form_row(form.mail) }}
    {{ form_row(form.date_de_naissance) }}
    {{ form_row(form.lieu_de_naissance) }}
    {{ form_row(form.statut) }}
    {{ form_row(form.LogementsID) }}
    {{ form_row(form.num_comptable) }}
    {{ form_row(form.debut_bail) }}
    {{ form_row(form.montant_caution) }}

    <h2>Loyer HC</h2>
    {{ form_row(form.loyer_montant) }}
    {{ form_row(form.loyer_date) }}<p><i>date vide = date de début de bail</i></p>

    <h2>Charge</h2>
    {{ form_row(form.charge_montant) }}
    {{ form_row(form.charge_date) }}<p><i>date vide = date de début de bail</i></p>

    <h2>Packs Services</h2>
    {{ form_row(form.PS_montant) }}
    {{ form_row(form.PS_date) }}<p><i>date vide = date de début de bail</i></p>

    {{ form_row(form.date_EDL_entree) }}

    <div class="section-header">
        <h2>Garant :</h2>

        <button type="button" onclick="addGarantPhysique()">
            ➕ Physique
        </button>

        <button type="button" onclick="addGarantVisale()">
            ➕ Visale
        </button>
    </div>

    <div id="garants-physiques-container"
        data-prototype="{{ form_widget(form.garantsPhysiques.vars.prototype)|e('html_attr') }}">
    </div>
    
    <div id="garants-visale-container"
        data-prototype="{{ form_widget(form.garantsVisale.vars.prototype)|e('html_attr') }}">
    </div>
    <p><i>si c'est un garant visale, alors date vide = date de début de bail</i></p>



    {{ form_row(form.commentaire) }}

    {{ form_row(form._token) }}
    <button type="submit">Créer</button>
    </form>
    
{{ form_end(form, { render_rest: false }) }}



<link rel="stylesheet" href="{{ asset('css/style_form.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">



<script>
function addGarantPhysique() {
    const visaleContainer = document.getElementById('garants-visale-container');
    const physiqueContainer = document.getElementById('garants-physiques-container');
    visaleContainer.innerHTML = '';

    const prototype = physiqueContainer.dataset.prototype;

    const index = physiqueContainer.children.length;

    const newForm = prototype.replace(/__name__/g, index);

    const div = document.createElement('div');
    div.classList.add('garant-item');
    div.innerHTML = newForm;

    // bouton suppression (ce que tu as demandé)
    div.innerHTML += '<button type="button" onclick="this.parentNode.remove()">❌</button>';


    physiqueContainer.appendChild(div);
}

function addGarantVisale() {
    const visaleContainer = document.getElementById('garants-visale-container');
    const physiqueContainer = document.getElementById('garants-physiques-container');

    physiqueContainer.innerHTML = '';
    if (visaleContainer.children.length > 0) return;

    const prototype = visaleContainer.dataset.prototype;
    const index = visaleContainer.children.length;

    const newForm = prototype.replace(/__name__/g, index);

    const div = document.createElement('div');
    div.classList.add('garant-item');
    div.innerHTML = newForm;

    div.innerHTML += '<button type="button" onclick="this.parentNode.remove()">❌</button>';

    visaleContainer.appendChild(div);
}
</script>
{% endblock %}
