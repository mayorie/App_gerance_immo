{% extends 'base.html.twig' %}

{% block title %}index logements{% endblock %}

{% block body %}

    <div class="div-titre">
        <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
        <h1>Index des logements</h1>
        <a href="{{ path('logement_new') }}" class="btn-create">➕ Créer un logement</a>
    </div>

    <table style="border-collapse: separate; border-spacing: 8px 5px; width: 100%;">
    <thead>
        <tr>
            <th>REF APPART</th>
            <th>SIRET</th>
            <th>APPT</th>
            <th>ADRESSE</th>
            <th>CP</th>
            <th>VILLE</th>
            <th class="col-fit">COMPTE COMPTABLE (7)</th>
            <th>MODIF</th>
            <th>SUPPR</th>

        </tr>
    </thead>

    <tbody>
        {% for logement in logements %}
            <tr>
                <td>{{ logement.IdAppart }}</td>
                <td>{{ logement.SIRET }}</td>
                <td>{{ logement.appt }}</td>
                <td>{{ logement.adresse }}</td>
                <td>{{ logement.CodePostal }}</td>
                <td>{{ logement.ville }}</td>
                <td class="col-fit">{{ logement.pcgPrestation ? logement.pcgPrestation.compte : '' }}</td>
                <td>
                    <a href="{{ path('logement_edit', {id: logement.id}) }}" >
                    ✏️
                    </a>
                </td>
                <td>
                    <form method="post" action="{{ path('logement_delete', {'id': logement.id}) }}" onsubmit="return confirm('Supprimer ce logement ?\n(Cela supprimera tout les locataires et ce qui leur est affilié.)');" >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ logement.id) }}">
                        <button type="submit">🗑️</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">
{% endblock %}
