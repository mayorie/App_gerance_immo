{% extends 'base.html.twig' %}

{% block title %}{{ editMode ? 'modif' : 'ajout' }} logement{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_logements') }}" class="btn-retour">Retour</a>
    <h1>Ajouter un logement</h1>
</div>

{{ form_start(form) }}

    {{ form_row(form.id_appart) }}
    {{ form_row(form.residence) }}
    {{ form_row(form.batiment) }}
    {{ form_row(form.appt) }}
    {{ form_row(form.adresse) }}
    {{ form_row(form.code_postal) }}
    {{ form_row(form.ville) }}
    {{ form_row(form.SIRET) }}
    {{ form_row(form.num_chambre) }}

    {{ form_row(form.pcgPrestation) }}

    {{ form_row(form.commentaire) }}

    <button type="submit">
        {{ editMode ? 'Modifier' : 'Créer' }}
    </button>
{{ form_end(form) }}
<link rel="stylesheet" href="{{ asset('css/style_form.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">
{% endblock %}
