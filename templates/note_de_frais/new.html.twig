{% extends 'base.html.twig' %}

{% block title %}Saisie par lot - Notes de Frais{% endblock %}

{% block body %}

<form method="post">

<div class="div-titre" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div style="flex: 0 0 auto;">
        <a href="{{ path('note_de_frais_index') }}" class="btn-retour">Retour</a>
    </div>
    <div style="flex: 1; text-align: center;">
        <h1 style="margin: 0; display: inline-block;">Saisie par lot - Notes de frais</h1>
    </div>
    <div style="flex: 0 0 auto; display: flex; gap: 10px; align-items: center;">
        <button type="button" id="btn-add-row" class="btn-create" style="cursor: pointer; font-size: 13px;">
            ➕ Ajouter une ligne
        </button>
        <button type="submit" class="btn-export" style="cursor: pointer; border: none; font-size: 13px;">
            💾 Enregistrer
        </button>
    </div>
</div>

<hr>

<div style="margin-bottom: 10px; display: flex; align-items: center; gap: 10px;">
    <label for="cout_km" style="font-size: 13px; font-weight: bold; color: #333; margin: 0;">Coût kilométrique (€/km) :</label>
    <input type="number" step="0.001" id="cout_km" name="cout_km" value="0.234" class="input-num" style="width: 80px; text-align: right; font-weight: bold; padding: 4px 8px;">
</div>

<p style="font-size: 12px; color: #555; margin-bottom: 15px;">
    ℹ️ Coût kilométrique : 534€ d'assurance / 18000km annuel (pro&perso) + 6,4L(moyenne au 100km) / 100 x 1.82€ du litre + 56€ le pneu x 4 / 45000km (durée de vie moyenne) + 1500€ entretien annuel / 18000
    <br>
    ℹ️ Formule de calcul automatique : <strong>Frais total = (Distance × Coût kilométrique) + Péage + Parking</strong>
</p>

    <table id="table-batch" style="border-collapse: separate; border-spacing: 8px 5px; width: 100%;">
        <thead>
            <tr>
                <th>Date</th>
                <th>Compte PCG 6</th>
                <th>Motif</th>
                <th>Distance (km)</th>
                <th>Péage (€)</th>
                <th>Parking (€)</th>
                <th>Frais total (€)</th>
                <th style="width: 40px; text-align: center;">Action</th>
            </tr>
        </thead>
        <tbody id="batch-tbody">
            <tr class="batch-row">
                <td>
                    <input type="date" name="dates[]" value="{{ "now"|date("Y-m-d") }}" class="input-date">
                </td>
                <td>
                    <select name="pcg_ids[]" class="input-select">
                        <option value="">-- Sélectionner --</option>
                        {% for pcg in pcgs %}
                            <option value="{{ pcg.id }}">{{ pcg.compte }} - {{ pcg.libelle }}</option>
                        {% endfor %}
                    </select>
                </td>
                <td>
                    <input type="text" name="motifs[]" placeholder="Motif du déplacement" class="input-text">
                </td>
                <td>
                    <input type="number" step="0.01" name="distances[]" placeholder="0.00" class="input-num input-distance">
                </td>
                <td>
                    <input type="number" step="0.01" name="peages[]" placeholder="0.00" class="input-num input-peage">
                </td>
                <td>
                    <input type="number" step="0.01" name="parkings[]" placeholder="0.00" class="input-num input-parking">
                </td>
                <td>
                    <input type="number" step="0.01" name="frais_totals[]" placeholder="0.00" class="input-num input-frais-total" style="font-weight: bold;">
                </td>
                <td style="text-align: center;">
                    <button type="button" class="btn-remove-row" onclick="removeRow(this)" title="Supprimer la ligne">🗑️</button>
                </td>
            </tr>
        </tbody>
    </table>

</form>

<template id="row-template">
    <tr class="batch-row">
        <td>
            <input type="date" name="dates[]" value="{{ "now"|date("Y-m-d") }}" class="input-date">
        </td>
        <td>
            <select name="pcg_ids[]" class="input-select">
                <option value="">-- Sélectionner --</option>
                {% for pcg in pcgs %}
                    <option value="{{ pcg.id }}">{{ pcg.compte }} - {{ pcg.libelle }}</option>
                {% endfor %}
            </select>
        </td>
        <td>
            <input type="text" name="motifs[]" placeholder="Motif du déplacement" class="input-text">
        </td>
        <td>
            <input type="number" step="0.01" name="distances[]" placeholder="0.00" class="input-num input-distance">
        </td>
        <td>
            <input type="number" step="0.01" name="peages[]" placeholder="0.00" class="input-num input-peage">
        </td>
        <td>
            <input type="number" step="0.01" name="parkings[]" placeholder="0.00" class="input-num input-parking">
        </td>
        <td>
            <input type="number" step="0.01" name="frais_totals[]" placeholder="0.00" class="input-num input-frais-total" style="font-weight: bold;">
        </td>
        <td style="text-align: center;">
            <button type="button" class="btn-remove-row" onclick="removeRow(this)" title="Supprimer la ligne">🗑️</button>
        </td>
    </tr>
</template>

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

<style>
    #table-batch {
        width: 100%;
        border-collapse: separate;
        border-spacing: 8px 6px;
    }
    #table-batch th {
        white-space: nowrap;
        padding: 8px 10px;
    }
    .input-date, .input-select, .input-text, .input-num {
        padding: 7px 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 13px;
        box-sizing: border-box;
    }
    .input-date {
        width: 145px;
    }
    .input-select {
        width: 100%;
        min-width: 260px;
    }
    .input-text {
        width: 100%;
        min-width: 280px;
    }
    .input-num {
        width: 110px;
        text-align: right;
    }
    .input-frais-total {
        width: 120px;
        background-color: #f8fafc;
        color: #0d47a1;
    }
    .btn-remove-row {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        padding: 6px 8px;
        border-radius: 4px;
        transition: background-color 0.2s ease;
    }
    .btn-remove-row:hover {
        background-color: rgba(220, 53, 69, 0.15);
    }
</style>

<script>
    function getCoutKm() {
        const input = document.getElementById('cout_km');
        const val = parseFloat(input ? input.value : '0.234');
        return isNaN(val) ? 0.234 : val;
    }

    function bindRowEvents(row) {
        const distanceInput = row.querySelector('.input-distance');
        const peageInput = row.querySelector('.input-peage');
        const parkingInput = row.querySelector('.input-parking');
        const fraisTotalInput = row.querySelector('.input-frais-total');

        function updateRowTotal() {
            const distance = parseFloat(distanceInput.value) || 0;
            const peage = parseFloat(peageInput.value) || 0;
            const parking = parseFloat(parkingInput.value) || 0;
            const coutKm = getCoutKm();

            if (distance > 0 || peage > 0 || parking > 0) {
                const total = Math.round((distance * coutKm + peage + parking) * 100) / 100;
                fraisTotalInput.value = total.toFixed(2);
            } else if (!distanceInput.value && !peageInput.value && !parkingInput.value) {
                fraisTotalInput.value = '';
            }
        }

        row._updateTotal = updateRowTotal;

        distanceInput.addEventListener('input', updateRowTotal);
        peageInput.addEventListener('input', updateRowTotal);
        parkingInput.addEventListener('input', updateRowTotal);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const tbody = document.getElementById('batch-tbody');
        const btnAdd = document.getElementById('btn-add-row');
        const template = document.getElementById('row-template');
        const coutKmInput = document.getElementById('cout_km');

        // Initialiser les lignes existantes
        document.querySelectorAll('.batch-row').forEach(bindRowEvents);

        // Mettre à jour toutes les lignes si le coût kilométrique change
        if (coutKmInput) {
            coutKmInput.addEventListener('input', function() {
                document.querySelectorAll('.batch-row').forEach(row => {
                    if (row._updateTotal) {
                        row._updateTotal();
                    }
                });
            });
        }

        // Ajouter une nouvelle ligne
        btnAdd.addEventListener('click', function() {
            const clone = template.content.cloneNode(true);
            const newRow = clone.querySelector('tr');
            tbody.appendChild(newRow);
            bindRowEvents(newRow);
        });
    });

    function removeRow(btn) {
        const tbody = document.getElementById('batch-tbody');
        const row = btn.closest('tr');
        if (tbody.querySelectorAll('tr').length > 1) {
            row.remove();
        } else {
            // Vider les champs si c'est la seule ligne restante
            row.querySelectorAll('input').forEach(input => {
                if (input.type === 'date') {
                    input.value = new Date().toISOString().split('T')[0];
                } else if (input.id !== 'cout_km') {
                    input.value = '';
                }
            });
            row.querySelectorAll('select').forEach(select => select.value = '');
        }
    }
</script>

{% endblock %}
