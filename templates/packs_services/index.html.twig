{% extends 'base.html.twig' %}

{% block title %}index charges{% endblock %}

{% block body %}


<div class="div-titre">
        <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
        <h1>Liste des packs services</h1>
        <a href="{{ path('packs_services_batch') }}" class="btn-create">➕ Créer révisions des packs services</a>
</div>

<form method="get" action="{{ path('app_packs_services') }}">
    <label for="locataire">Filtrer par locataire :</label>

    <select name="locataireId" id="locataire">
        <option value="">-- Tous les locataires --</option>

        {% for l in locataires %}
            <option value="{{ l.id }}"
                {% if locataire and locataire.id == l.id %}selected{% endif %}>
                {{ l.nom }} 
                {{ l.prenom }}
            </option>
        {% endfor %}
    </select>

    <button type="submit">Filtrer</button>
</form>

<hr>

{% if locataire %}
    <h2>Packs services du locataire : {{ locataire.nom }} {{ locataire.prenom }}</h2>
{% else %}
    <h2>Packs services & Révisions des Packs services</h2>
{% endif %}

{% if packsServices is empty %}
    <p>Aucun packs services trouvée. (c'est pas normal)</p>
{% else %}

<table style="border-collapse: separate; border-spacing: 10px; width: 100%;">
    <thead>
        <tr>
            <th>Locataire</th>
            <th>Logement</th>
            <th>Montant</th>
            <th>Date</th>
            <th>MODIF</th>
            <th>SUPPR</th>
        </tr>
    </thead>
    <tbody>
        {% for packService in packsServices %}
            <tr>
                <td>{{ packService.LocatairesID.nom }} {{ packService.LocatairesID.prenom }}</td>
                <td>{{ packService.LocatairesID.LogementsID.idAppart }}</td>
                <td>{{ packService.montant }} €</td>
                <td>{{ packService.dateMES ? packService.dateMES|date('d/m/Y') : '-' }}</td>
                <td>
                    <a href="{{ path('packs_services_edit', {'id': packService.id}) }}" >
                    ✏️
                    </a>
                </td>
                <td>
                    <form method="post" action="{{ path('packs_services_delete', {'id': packService.id}) }}" onsubmit="return confirm('Supprimer cette packService ?');" >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ packService.id) }}">
                        <button type="submit">🗑️</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <script>
                alert("{{ message }}");
            </script>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <script>
                alert("{{ message }}");
            </script>
        {% endfor %}
    </tbody>
</table>

{% endif %}

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

{% endblock %}