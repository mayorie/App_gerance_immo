{% extends 'base.html.twig' %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_paiements_mensuels') }}" class="btn-retour">Retour</a>

    <h1>Ajout des paiements</h1>

    <button type="button" id="add-paiement" class="btn-create">
        Ajouter un paiement
    </button>

    <button type="submit" form="paiements-form" class="btn-create">
        Enregistrer
    </button>
</div>

{{ form_start(form, {
    attr: {
        id: 'paiements-form'
    }
}) }}

<table style="border-collapse: separate; border-spacing: 8px 5px; width: 100%;">

    <thead>

        <tr>
            <th colspan="2">Info locataire</th>
            <th colspan="1">Saisie du</th>
            <th colspan="7">Total du</th>
            <th colspan="3">Part reçue du locataire</th>
            <th colspan="3">Part reçue de la CAF</th>
            <th colspan="3">Remboursement bailleur</th>
            <th colspan="1">Restant dû</th>
            <th colspan="2">édition</th>
        </tr>

        <tr>
            <th>Locataire</th>
            <th>appart</th>

            <th>date</th>

            <th>caution</th>
            <th>regul. Pack S</th>
            <th>regul. charges</th>
            <th>Loyer HC</th>
            <th>charges</th>
            <th>Pack S</th>
            <th>Total</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Montant</th>

            <th>Modif</th>
            <th>Supr</th>
        </tr>

    </thead>

    {% set prototype %}
        {% include 'paiements_mensuels/_ligne.html.twig' with {
            form: form.paiements.vars.prototype
        } %}
    {% endset %}

    <tbody id="paiements-container">
    </tbody>

</table>

{{ form_end(form, { render_rest: false }) }}





<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">






<script>

const container = document.getElementById('paiements-container');

const prototype = `{{ prototype|e('js') }}`;

let index = 0;

function addPaiement() {

    const newForm = prototype.replace(/__name__/g, index);

    container.insertAdjacentHTML('beforeend', newForm);

    index++;
}

document
    .getElementById('add-paiement')
    .addEventListener('click', addPaiement);

// première ligne automatique
addPaiement();






document.addEventListener('change', function (e) {

    if (
        e.target.name.includes('[LocatairesID]')
    ) {

        const option = e.target.selectedOptions[0];


        const appart = parseFloat(option.dataset.appart) || 0;
        const caution = parseFloat(option.dataset.caution) || 0;
        const loyer = parseFloat(option.dataset.loyer) || 0;
        const charge = parseFloat(option.dataset.charge) || 0;
        const packs = parseFloat(option.dataset.packs) || 0;

        const total = caution + loyer + charge + packs;

        const row = e.target.closest('tr');


        const appartCell = row.querySelector('.appart-cell');
        const cautionCell = row.querySelector('.caution-cell');
        const loyerCell = row.querySelector('.loyer-cell');
        const chargeCell = row.querySelector('.charge-cell');
        const packsCell = row.querySelector('.packs-cell');
        const totalCell = row.querySelector('.total-cell');


        if (appartCell) {
            appartCell.textContent = appart;
        }
        if (cautionCell) {
            cautionCell.textContent = caution;
        }
        if (loyerCell) {
            loyerCell.textContent = loyer;
        }
        if (chargeCell) {
            chargeCell.textContent = charge;
        }
        if (packsCell) {
            packsCell.textContent = packs;
        }
        if (totalCell) {
            totalCell.textContent = total;
        }
    }
});

</script>

{% endblock %}