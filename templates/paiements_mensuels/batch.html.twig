{% extends 'base.html.twig' %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_paiements_mensuels') }}" class="btn-retour">Retour</a>

    <h1>Ajout des paiements</h1>

    <button type="button" id="add-paiement" class="btn-create">
        Ajouter un paiement
    </button>

    <button type="submit" form="paiements-form" class="btn-create">
        Enregistrer
    </button>
</div>

{{ form_start(form, {
    attr: {
        id: 'paiements-form'
    }
}) }}

<table style="border-collapse: separate; border-spacing: 8px 5px; width: 100%;">

    <thead>

        <tr>
            <th colspan="2">Info locataire</th>
            <th colspan="1">Saisie du</th>
            <th colspan="8">Total du</th>
            <th colspan="3">Part reçue du locataire</th>
            <th colspan="3">Part reçue de la CAF</th>
            <th colspan="4">Remboursement bailleur</th>
            <th colspan="1">Restant dû</th>
            <th colspan="1">édition</th>
        </tr>

        <tr>
            <th>Locataire</th>
            <th>appart</th>

            <th>date</th>

            <th>restant du m-1</th>
            <th>caution</th>
            <th>regul. Pack S</th>
            <th>regul. charges</th>
            <th>Loyer HC</th>
            <th>charges</th>
            <th>Pack S</th>
            <th>Total</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Motif</th>
            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Montant</th>

            <th>Supr</th>
        </tr>

    </thead>

    {% set prototype %}
        {% include 'paiements_mensuels/_ligne.html.twig' with {
            form: form.paiements.vars.prototype
        } %}
    {% endset %}

    <tbody id="paiements-container" data-index="{{ form.paiements|length }}">
    </tbody>

</table>

<div style="display:none;">
    {{ form_widget(form.paiements) }}
</div>

{{ form_end(form) }}




<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">






<script>

const container = document.getElementById('paiements-container');

const prototype = `{{ prototype|e('js') }}`;

let index = container.dataset.index;

function addPaiement() {

    const newForm = prototype.replace(/__name__/g, index);
    container.insertAdjacentHTML('beforeend', newForm);

    const rows = container.querySelectorAll('.paiement-item');
    const row = rows[rows.length - 1];

    let year;
    let month;

    if (rows.length > 1) {

        const previousRow = rows[rows.length - 2];

        const previousDate =
            previousRow.querySelector('.paiement-date')?.value;

        if (previousDate) {

            const previous = new Date(previousDate);

            year = previous.getFullYear();
            month = String(previous.getMonth() + 1).padStart(2, '0');

        } else {

            const today = new Date();

            year = today.getFullYear();
            month = String(today.getMonth() + 1).padStart(2, '0');
        }

    } else {

        const today = new Date();

        year = today.getFullYear();
        month = String(today.getMonth() + 1).padStart(2, '0');
    }

    const firstDay = `${year}-${month}-01`;
    const fifthDay = `${year}-${month}-05`;

    row.querySelector('.paiement-date').value = firstDay;
    row.querySelector('[name*="[part_recue_de_la_CAF_date]"]').value = fifthDay;

    index++;
}




document
    .getElementById('add-paiement')
    .addEventListener('click', addPaiement);

// première ligne automatique
addPaiement();






function recalcRow(row) {

    const option = row.querySelector('[name*="[LocatairesID]"]')?.selectedOptions[0];
    if (!option) return;

    let caution = parseFloat(option.dataset.caution) || 0;
    let restantm = parseFloat(option.dataset.restantm) || 0;

    const currentLocataire = row.querySelector('[name*="[LocatairesID]"]').value;

    const allRows = document.querySelectorAll('.paiement-item');

    for (const previousRow of allRows) {

        if (previousRow === row) break;

        const previousLocataire =
            previousRow.querySelector('[name*="[LocatairesID]"]')?.value;

        if (previousLocataire === currentLocataire) {

            caution = 0;

            const prevRestant = parseFloat(
                previousRow.querySelector('.restant-du-input')?.value
            );

            if (!isNaN(prevRestant)) {
                restantm = prevRestant;
            }
        }
    }

    let loyer = parseFloat(option.dataset.loyer) || 0;
    let charge = parseFloat(option.dataset.charge) || 0;
    let packs = parseFloat(option.dataset.packs) || 0;

    const bailIN = option.dataset.bailIn || null;
    const bailOUT = option.dataset.bailOut || null;

    if (caution>0 ) {

        const dateBail = new Date(bailIN);

        const jourEntree = dateBail.getDate();

        const annee = dateBail.getFullYear();
        const mois = dateBail.getMonth();

        // nombre de jours dans le mois
        const joursDansLeMois = new Date(
            annee,
            mois + 1,
            0
        ).getDate();

        // jours à payer jusqu'à la fin du mois
        const joursAPayer = joursDansLeMois - jourEntree +1;

        // prorata
        loyer = Math.round((
            (loyer / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
        charge = Math.round((
            (charge / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
        packs = Math.round((
            (packs / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
    }

    if (bailOUT) {

        const dateBail = new Date(bailOUT);

        const joursAPayer = dateBail.getDate();

        const annee = dateBail.getFullYear();
        const mois = dateBail.getMonth();

        // nombre de jours dans le mois
        const joursDansLeMois = new Date(
            annee,
            mois + 1,
            0
        ).getDate();

        // prorata
        loyer = Math.round((
            (loyer / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
        charge = Math.round((
            (charge / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
        packs = Math.round((
            (packs / joursDansLeMois) * joursAPayer
        ) * 100) / 100;
    }



    const regulPacks = parseFloat(row.querySelector('[name*="[RegulPacksServices]"]').value) || 0;
    const regulCharges = parseFloat(row.querySelector('[name*="[RegulProvisionsPourCharges]"]').value) || 0;

    const partLoc = parseFloat(row.querySelector('[name*="[part_recue_du_locataire_montant]"]').value) || 0;
    const partCAF = parseFloat(row.querySelector('[name*="[part_recue_de_la_CAF_montant]"]').value) || 0;
    const partRBT = parseFloat(row.querySelector('[name*="[RBT_montant]"]').value) || 0;




    const total =
        Math.round((
            caution +
            loyer +
            charge +
            packs +
            regulPacks +
            regulCharges +
            restantm
        )*100)/100;

    const restantDu = Math.round((total - partLoc - partCAF + partRBT)*100)/100;

    const appart = option.dataset.appart;

    row.querySelector('.restant-du-input').value = restantDu;
    row.querySelector('.total-cell').textContent = total;
    row.querySelector('.restantm-cell').textContent = restantm;
    row.querySelector('.caution-cell').textContent = caution;
    row.querySelector('.appart-cell').textContent = appart;
    row.querySelector('.loyer-cell').textContent = loyer;
    row.querySelector('.charge-cell').textContent = charge;
    row.querySelector('.packs-cell').textContent = packs;
}






document.addEventListener('input', function (e) {

    const row = e.target.closest('tr');

    if (!row) {
        return;
    }
    recalcRow(row);

    // changement locataire
    if (e.target.name.includes('[LocatairesID]')) {

        const option = e.target.selectedOptions[0];



        recalcRow(row);
    }

    // modification régules
    if (
        e.target.name.includes('[RegulPacksServices]') ||
        e.target.name.includes('[RegulProvisionsPourCharges]')
    ) {
        recalcRow(row);
    }
});






document.addEventListener('click', function (e) {
    if (e.target.classList.contains('btn-delete-row')) {

        const row = e.target.closest('tr');

        if (!row) return;

        const rows = [...document.querySelectorAll('.paiement-item')];
        const index = rows.indexOf(row);

        row.remove();

        // recalcul toutes les lignes après suppression
        const remainingRows = document.querySelectorAll('.paiement-item');

        remainingRows.forEach(r => {
            recalcRow(r);
        });
    }
});

</script>

{% endblock %}