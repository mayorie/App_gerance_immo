{% extends 'base.html.twig' %}

{% block title %}Paiements mensuels{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
    <h1>Paiements mensuels</h1>
    <a href="{{ path('paiements_batch') }}" class="btn-create">➕ Créer des paiements</a>
    <button id="exportCsv" class="btn-create">📥 Export CSV</button>
</div>

<form method="get" action="{{ path('app_paiements_mensuels') }}">
    <label>Année :</label>

    <select name="annee">
        <option value="">-- Toutes --</option>
        {% for year in annees %}
            <option value="{{ year }}" {% if annee == year %}selected{% endif %}>
                {{ year }}
            </option>
        {% endfor %}
    </select>

    <label>Locataire :</label>

    <select name="locataireId">
        <option value="">-- Tous --</option>
        {% for l in locataires %}
            <option value="{{ l.id }}" {% if locataireId == l.id %}selected{% endif %}>
                {{ l.nom }} {{ l.prenom }}
            </option>
        {% endfor %}
    </select>

    <button type="submit">Filtrer</button>

    <label style="margin-left: 20px;">
        <input type="checkbox" id="comptabilite"> Comptabilité ?
    </label>
</form>

<hr>

{% if paiements is empty %}
    <p>Aucun paiement trouvé.</p>
{% else %}

<table style="border-collapse: separate; border-spacing:  8px 5px; width: 100%;">
    <thead>
        <tr>
            <th colspan="2">Info locataire</th>
            <th colspan="1">Saisie du</th>
            <th colspan="7">Total du</th>
            <th colspan="3">Part reçue du locataire</th>
            <th colspan="3">Part reçue de la CAF</th>
            <th colspan="3">Remboursement bailleur</th>
            <th colspan="1">Restant dû</th>
            <th colspan="1">édition</th>
        </tr>
        <tr>
            <th>Locataire</th>
            <th>appart</th>

            <th>date</th>

            <th>caution</th>
            <th>regul. Pack S</th>
            <th>regul. charges</th>
            <th>Loyer HC</th>
            <th>charges</th>
            <th>Pack S</th>
            <th>Total</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Montant</th>

            <th style="display:none;">Modif</th>
            <th>Supr</th>
        </tr>
    </thead>

    <tbody>

{% for item in paiements %}

    {% set p = item.paiement %}
    {% set loyer = item.loyerHC %}
    {% set charge = item.charge %}
    {% set PS = item.PS %}
    {% set RBT = item.RBT %}

    <tr
        class="paiement-row"

        data-caution="{{ p.id in firstPaiementsIds ? p.LocatairesID.montantCaution : 0 }}"
        data-regul-packs="{{ p.RegulPacksServices ?? 0 }}"
        data-regul-charges="{{ p.RegulProvisionsPourCharges ?? 0 }}"
        data-loyer="{{ loyer ?? 0 }}"
        data-charge="{{ charge ?? 0 }}"
        data-ps="{{ PS ?? 0 }}"
        data-num-comptable="{{ p.LocatairesID.numComptable ?? '' }}"

        data-bail-in="{{ p.LocatairesID.debutBail ? p.LocatairesID.debutBail|date('Y-m-d') : '' }}"
        data-bail-out="{{ p.LocatairesID.dateDeSortie ? p.LocatairesID.dateDeSortie|date('Y-m-d') : '' }}"
    >

        <td>{{ p.LocatairesID.nom }} {{ p.LocatairesID.prenom }}</td>
        <td>{{ p.LocatairesID.LogementsID.idAppart }}</td>

        <td>{{ p.Date ? p.Date|date('d/m/Y') : '-' }}</td>

        <td>
            {% if p.id in firstPaiementsIds %}
                {{ p.LocatairesID.montantCaution }} €
            {% else %}
                -
            {% endif %}
        </td>

        <td>{{ p.RegulPacksServices ?? 0 }} €</td>
        <td>{{ p.RegulProvisionsPourCharges ?? 0 }} €</td>

        <td class="loyer-cell">{{ loyer ?? 0 }} €</td>
        <td class="charge-cell">{{ charge ?? 0 }} €</td>
        <td class="ps-cell">{{ PS ?? 0 }} €</td>

        <td class="total-cell"></td>

        <td>{{ p.partRecueDuLocataireDate ? p.partRecueDuLocataireDate|date('d/m/Y') : '-' }}</td>
        <td>{{ p.partRecueDuLocataireMode }}</td>
        <td>{{ p.partRecueDuLocataireMontant ? p.partRecueDuLocataireMontant ~ ' €' : '-' }}</td>

        <td>{{ p.partRecueDeLaCafDate ? p.partRecueDeLaCafDate|date('d/m/Y') : '-' }}</td>
        <td>{{ p.PartRecueDeLaCafMode }}</td>
        <td>{{ p.PartRecueDeLaCafMontant ? p.PartRecueDeLaCafMontant ~ ' €' : '-' }}</td>

        <td>{{ RBT and RBT.date ? RBT.date|date('d/m/Y') : '-' }}</td>
        <td>{{ RBT ? RBT.mode : '-' }}</td>

        <td>
            {% if RBT and RBT.montant is not null %}
                {{ RBT.montant }} €
            {% else %}
                -
            {% endif %}
        </td>

        <td>{{ p.RestantDuTropPercuFinDeMois }} €</td>

        <td style="display:none;">
            <a href="{{ path('paiement_edit', {id: p.id}) }}">
                ✏️
            </a>
        </td>

        <td>
            <form
                method="post"
                action="{{ path('paiements_delete', {'id': p.id}) }}"
                onsubmit="return confirm('Supprimer ce paiement ?');"
            >
                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('delete' ~ p.id) }}"
                >

                <button type="submit">🗑️</button>
            </form>
        </td>

    </tr>

{% endfor %}

</tbody>
</table>

{% endif %}

{# POPUP flash #}
{% for message in app.flashes('error') %}
    <script>alert("{{ message }}");</script>
{% endfor %}

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">


<script>
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.paiement-row').forEach(row => {

        const caution =
            parseFloat(row.dataset.caution) || 0;

        const regulPacks =
            parseFloat(row.dataset.regulPacks) || 0;

        const regulCharges =
            parseFloat(row.dataset.regulCharges) || 0;

        let loyer =
            parseFloat(row.dataset.loyer) || 0;

        let charge =
            parseFloat(row.dataset.charge) || 0;

        let ps =
            parseFloat(row.dataset.ps) || 0;

        const bailIN =
            row.dataset.bailIn || null;

        const bailOUT =
            row.dataset.bailOut || null;


        /*
        =========================
        PRORATA ENTRÉE
        =========================
        */

        if (bailIN && caution > 0) {

            const dateBail = new Date(bailIN);

            const jourEntree = dateBail.getDate();

            const annee = dateBail.getFullYear();
            const mois = dateBail.getMonth();

            const joursDansLeMois = new Date(
                annee,
                mois + 1,
                0
            ).getDate();

            const joursAPayer =
                joursDansLeMois - jourEntree + 1;

            loyer = Math.round((
                (loyer / joursDansLeMois) * joursAPayer
            ) * 100) / 100;

            charge = Math.round((
                (charge / joursDansLeMois) * joursAPayer
            ) * 100) / 100;

            ps = Math.round((
                (ps / joursDansLeMois) * joursAPayer
            ) * 100) / 100;
        }


        /*
        =========================
        PRORATA SORTIE
        =========================
        */

        if (bailOUT) {

            const dateBail = new Date(bailOUT);

            const joursAPayer =
                dateBail.getDate();

            const annee = dateBail.getFullYear();
            const mois = dateBail.getMonth();

            const joursDansLeMois = new Date(
                annee,
                mois + 1,
                0
            ).getDate();

            loyer = Math.round((
                (loyer / joursDansLeMois) * joursAPayer
            ) * 100) / 100;

            charge = Math.round((
                (charge / joursDansLeMois) * joursAPayer
            ) * 100) / 100;

            ps = Math.round((
                (ps / joursDansLeMois) * joursAPayer
            ) * 100) / 100;
        }


        /*
        =========================
        TOTAL
        =========================
        */

        const total = Math.round((
            caution +
            regulPacks +
            regulCharges +
            loyer +
            charge +
            ps
        ) * 100) / 100;

        row.querySelector('.total-cell').textContent =
            total + ' €';

        row.querySelector('.loyer-cell').textContent =
            loyer + ' €';

        row.querySelector('.charge-cell').textContent =
            charge + ' €';

        row.querySelector('.ps-cell').textContent =
            ps + ' €';
    });

    // Export CSV functionality
    document.getElementById('exportCsv').addEventListener('click', function() {
        const table = document.querySelector('table');
        if (!table) return;

        const comptabilite = document.getElementById('comptabilite').checked;
        let csv = [];
        const rows = table.querySelectorAll('tr');
        const theadRows = table.querySelectorAll('thead tr');

        // Fusionner les deux lignes d'en-têtes
        if (theadRows.length >= 2) {
            const header1 = theadRows[0].querySelectorAll('th');
            const header2 = theadRows[1].querySelectorAll('th');

            let mergedHeader = [];
            let h2Index = 0;

            header1.forEach((h1, i) => {
                const colspan = parseInt(h1.getAttribute('colspan')) || 1;
                const h1Text = h1.textContent.trim();

                for (let j = 0; j < colspan; j++) {
                    const h2Text = header2[h2Index] ? header2[h2Index].textContent.trim() : '';
                    const mergedText = h1Text && h2Text ? h1Text + '-' + h2Text : (h1Text || h2Text);
                    const cleanedText = mergedText.replace(/"/g, '""');
                    mergedHeader.push('"' + cleanedText + '"');
                    h2Index++;

                    // Insérer le champ num_comptable après la 2ème colonne si comptabilité cochée
                    if (comptabilite && h2Index === 2) {
                        mergedHeader.push('"Num comptable"');
                    }
                }
            });

            csv.push(mergedHeader.join(','));
        }

        // Exporter les données du tbody
        let tbodyRows = table.querySelectorAll('tbody tr');
        tbodyRows = Array.from(tbodyRows);

        // Trier par numéro comptable croissant puis par date si comptabilité cochée
        if (comptabilite) {
            tbodyRows.sort((a, b) => {
                const numA = parseInt(a.dataset.numComptable) || 0;
                const numB = parseInt(b.dataset.numComptable) || 0;

                if (numA !== numB) {
                    return numA - numB;
                }

                // Second critère : tri par date (3ème colonne)
                const dateA = a.cells[2]?.textContent.trim() || '';
                const dateB = b.cells[2]?.textContent.trim() || '';
                return dateA.localeCompare(dateB);
            });
        }

        tbodyRows.forEach(row => {
            const cells = row.querySelectorAll('td');
            let rowData = [];
            let cellIndex = 0;

            cells.forEach(cell => {
                if (cell.style.display !== 'none') {
                    let text = cell.textContent.trim();
                    text = text.replace(/€/g, '').replace(/-/g, '');
                    text = '"' + text.replace(/"/g, '""') + '"';
                    rowData.push(text);
                    cellIndex++;

                    // Insérer le champ num_comptable après la 2ème colonne si comptabilité cochée
                    if (comptabilite && cellIndex === 2) {
                        const numComptable = row.dataset.numComptable || '';
                        rowData.push('"' + numComptable.replace(/"/g, '""') + '"');
                    }
                }
            });
            if (rowData.length > 0) {
                csv.push(rowData.join(','));
            }
        });

        const csvContent = csv.join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);

        link.setAttribute('href', url);
        link.setAttribute('download', 'paiements_mensuels_' + new Date().toISOString().slice(0, 10) + '.csv');
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });
});
</script>

{% endblock %}