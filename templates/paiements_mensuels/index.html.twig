{% extends 'base.html.twig' %}

{% block title %}Paiements mensuels{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
    <h1>Paiements mensuels</h1>
    <a href="{{ path('paiements_new') }}" class="btn-create">➕ Créer un paiement</a>
    <a href="{{ path('paiements_batch') }}" class="btn-create">➕ Créer des paiements</a>
</div>

<form method="get" action="{{ path('app_paiements_mensuels') }}">
    <label>Locataire :</label>

    <select name="locataireId">
        <option value="">-- Tous --</option>
        {% for l in locataires %}
            <option value="{{ l.id }}">
                {{ l.nom }} {{ l.prenom }}
            </option>
        {% endfor %}
    </select>

    <button type="submit">Filtrer</button>
</form>

<hr>

<h2>
    Paiements du mois :
    {{ (mois ?? "now"|date('Y-m'))|date("m/Y") }}
</h2>

{% if paiements is empty %}
    <p>Aucun paiement trouvé pour ce mois.</p>
{% else %}

<table style="border-collapse: separate; border-spacing:  8px 5px; width: 100%;">
    <thead>
        <tr>
            <th colspan="2">Info locataire</th>
            <th colspan="1">Saisie du</th>
            <th colspan="7">Total du</th>
            <th colspan="3">Part reçue du locataire</th>
            <th colspan="3">Part reçue de la CAF</th>
            <th colspan="3">Remboursement bailleur</th>
            <th colspan="1">Restant dû</th>
            <th colspan="2">édition</th>
        </tr>
        <tr>
            <th>Locataire</th>
            <th>appart</th>

            <th>date</th>

            <th>caution</th>
            <th>regul. Pack S</th>
            <th>regul. charges</th>
            <th>Loyer HC</th>
            <th>charges</th>
            <th>Pack S</th>
            <th>Total</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Date</th>
            <th>Mode</th>
            <th>Montant</th>

            <th>Montant</th>

            <th>Modif</th>
            <th>Supr</th>
        </tr>
    </thead>

    <tbody>
        {% for item in paiements %}
            {% set p = item.paiement %}
            {% set loyer = item.loyerHC %}
            {% set charge = item.charge %}
            {% set PS = item.PS %}
            {% set total =
                (p.id in firstPaiementsIds ? p.LocatairesID.montantCaution : 0)
                + (p.RegulPacksServices ?? 0)
                + (p.RegulProvisionsPourCharges ?? 0)
                + (loyer ?? 0)
                + (charge ?? 0)
                + (PS ?? 0)
            %}
            {% set RBT = item.RBT %}

            <tr>
                <td>{{ p.LocatairesID.nom }} {{ p.LocatairesID.prenom }}</td>
                <td>{{ p.LocatairesID.LogementsID.idAppart }}</td>


                <td>{{ p.Date ? p.Date|date('d/m/Y') : '-'  }}</td>


                <td>
                    {% if p.id in firstPaiementsIds %}
                        {{ p.LocatairesID.montantCaution }} €
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>{{ p.RegulPacksServices }} €</td>
                <td>{{ p.RegulProvisionsPourCharges }} €</td>
                <td>{{ loyer }} €</td>
                <td>{{ charge }} €</td>
                <td>{{ PS }} €</td>
                <td>{{ total }} €</td>


                <td>{{ p.partRecueDuLocataireDate ? p.partRecueDuLocataireDate|date('d/m/Y') : '-' }}</td>
                <td>{{ p.partRecueDuLocataireMode }}</td>
                <td>{{ p.partRecueDuLocataireMontant ? p.partRecueDuLocataireMontant ~ ' €' : '-' }}</td>


                <td>{{ p.partRecueDeLaCafDate ? p.partRecueDeLaCafDate|date('d/m/Y') : '-' }}</td>
                <td>{{ p.PartRecueDeLaCafMode }}</td>
                <td>{{ p.PartRecueDeLaCafMontant ? p.PartRecueDeLaCafMontant ~ ' €' : '-' }}</td>

                <td>{{ RBT and RBT.date ? RBT.date|date('d/m/Y') : '-' }}</td>
                <td>{{ RBT ? RBT.mode : '-' }}</td>
                <td>
                    {% if RBT and RBT.montant is not null %}
                        {{ RBT.montant }} €
                    {% else %}
                        -
                    {% endif %}
                </td>


                <td>{{ p.RestantDuTropPercuFinDeMois }} €</td>
                
                <td>
                    <a href="{{ path('paiement_edit', {id: p.id}) }}" >
                        ✏️
                    </a>
                </td>
                <td>
                    <form method="post" action="{{ path('paiements_delete', {'id': p.id}) }}" onsubmit="return confirm('Supprimer ce paiement ?');" >
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}">
                        <button type="submit">🗑️</button>
                    </form>
                </td>

            </tr>
        {% endfor %}
    </tbody>
</table>

{% endif %}

{# POPUP flash #}
{% for message in app.flashes('error') %}
    <script>alert("{{ message }}");</script>
{% endfor %}

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

{% endblock %}