{% extends 'base.html.twig' %}

{% block title %}Index PCG{% endblock %}

{% block body %}

<div class="div-titre">
    <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
    <h1>Liste des comptes PCG</h1>
    <a href="{{ path('pcg_batch') }}" class="btn-create">➕ Ajouter des comptes</a>
    <a href="{{ path('pcg_import') }}" class="btn-export">📥 Import CSV</a>
</div>

<hr>

{% if pcgs is empty %}
    <p>Aucun compte PCG trouvé.</p>
{% else %}

<table style="border-collapse: separate; border-spacing: 8px 5px;">
    <thead>
        <tr>
            <th>Compte</th>
            <th style="width: 330px;">Libellé</th>
            <th>SUPPR</th>
        </tr>
    </thead>
    <tbody>
        {% for pcg in pcgs %}
            <tr>
                <td>{{ pcg.compte }}</td>
                <td style="width: 330px; text-align: left;">{{ pcg.libelle }}</td>
                <td>
                    {% if pcg.factureFourns is empty and pcg.factureFourns2 is empty %}
                        <form method="post" action="{{ path('pcg_delete', {'id': pcg.id}) }}" onsubmit="return confirm('Supprimer ce compte PCG ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pcg.id) }}">
                            <button type="submit">🗑️</button>
                        </form>
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{% endif %}

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

{% endblock %}
