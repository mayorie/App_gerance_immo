{% extends 'base.html.twig' %}

{% block title %}Soldes de tout compte{% endblock %}

{% block body %}

    <div class="div-titre" style="justify-content: flex-start;">
        <a href="{{ path('app_home') }}" class="btn-retour">Retour</a>
        <h1 style="margin-left: 200px;">Soldes de tout compte</h1>
        {% if anneeSelectionnee %}
            <a href="{{ path('app_soldes_de_tout_compte_export_csv', {'annee': anneeSelectionnee}) }}" class="btn-create" style="margin-left: 120px;">📥 Export CSV {{ anneeSelectionnee }}</a>
        {% endif %}
    </div>

    <hr>

    <div style="margin-bottom: 20px;">
        <form method="get" style="display: inline;">
            <label for="annee">Filtrer par année :</label>
            <select name="annee" id="annee" onchange="this.form.submit()">
                <option value="">Toutes les années</option>
                {% for anneeData in annees %}
                    <option value="{{ anneeData.annee }}" {% if anneeSelectionnee == anneeData.annee %}selected{% endif %}>
                        {{ anneeData.annee }}
                    </option>
                {% endfor %}
            </select>
        </form>
        <i style="font-size: 9px;">⚠️ L'export CSV est accessible après sélection d'une année.</i>
    </div>

    <hr>

    <table style="border-collapse: separate; border-spacing: 8px 5px;">
    <thead>
        <tr>
            <th>LOCATAIRE</th>
            <th>LOGEMENT</th>
            <th>NUM COMPTABLE</th>
            <th>DATE SOLDE</th>
            <th>MODE PAIEMENT</th>
            <th>BANQUE</th>
            <th>MONTANT SOLDE</th>
        </tr>
    </thead>

    <tbody>
        {% for locataire in locataires %}
            {% if locataire.montantSoldeDeToutCompte is not null %}
                <tr>
                    <td>{{ locataire.prenom }} {{ locataire.nom }}</td>
                    <td>{{ locataire.LogementsID.idAppart }}</td>
                    <td>{{ locataire.numComptable }}</td>
                    <td>{{ locataire.dateSoldeDeToutCompte ? locataire.dateSoldeDeToutCompte|date('d/m/Y') : '' }}</td>
                    <td>{{ locataire.modePaiementSoldeDeToutCompte }}</td>
                    <td>{{ locataire.banqueSoldeDeToutCompte }}</td>
                    <td>{{ locataire.montantSoldeDeToutCompte }} €</td>
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>

<link rel="stylesheet" href="{{ asset('css/style_tableau.css') }}">
<link rel="stylesheet" href="{{ asset('css/style_titre.css') }}">

{% endblock %}
